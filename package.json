{
  "name": "yu-gi-oh-project",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Yu-Gi-Oh fan dueling platform (web/desktop/mobile)",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./apps/** run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm -r --parallel --filter=./apps/** run dev",
    "dev:server": "pnpm --filter @ygo/server dev",
    "dev:web": "pnpm --filter @ygo/web dev",
    "cards:refresh": "pnpm --filter @ygo/cards-data refresh"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
